NUXT_PUBLIC_API_BASE_URL=https://your-pocketbase-instance.example/api/
NUXT_PUBLIC_API_ENDPOINT=collections/budget_tracker_transactions/records
# Migration script only (scripts/pb-migrate.mjs). Never prefix these with NUXT_PUBLIC_.
POCKETBASE_URL=https://your-pocketbase-instance.example
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
# Optional alternative to the email and password above; if set, the script skips the login
POCKETBASE_ADMIN_TOKEN=
# Card payment test on the laptop (README, Rollout: card payments): SumUp SANDBOX keys and the owner's id.
# Never the notifier login or live keys: those go into akinai.env on the server.
OWNER_ID=
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_AFFILIATE_KEY=
SUMUP_AFFILIATE_APP_ID=
